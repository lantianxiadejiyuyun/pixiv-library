# Native main service and queue processes; AI inference remains a separate service.
FROM node:24-alpine AS web
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM rust:1.90-slim-bookworm AS build
WORKDIR /src
COPY server/rust/Cargo.toml server/rust/Cargo.lock ./
COPY server/rust/src ./src
COPY server/rust/contracts/routes.json ./contracts/routes.json
COPY server/rust/contracts/mysql-schema.json server/rust/contracts/sqlite-schema.json ./contracts/
COPY server/rust/contracts/mobile-catalog.json ./contracts/
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --locked --release && cp target/release/qiye-server /qiye-server

FROM debian:bookworm-slim
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gzip apksigner aapt default-jre-headless && \
    rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home library
RUN set -eu; case "$TARGETARCH" in \
    amd64) asset=mihomo-linux-amd64-v1-v1.19.32.gz; digest=306f81e723e60ce6b828899a6fe83e1d00e9ecefb2dc8d4d849312a5bc00efdc;; \
    arm64) asset=mihomo-linux-arm64-v1.19.32.gz; digest=9dd862e28b46ff7d775f169cceebc28deccaa0a9e804237d421cd2571e0caba0;; \
    *) exit 1;; esac; \
    curl --fail --location --proto '=https' --tlsv1.2 --max-time 180 "https://github.com/MetaCubeX/mihomo/releases/download/v1.19.32/$asset" -o /tmp/mihomo.gz; \
    echo "$digest  /tmp/mihomo.gz" | sha256sum -c -; gzip -dc /tmp/mihomo.gz > /usr/local/bin/mihomo; \
    chmod 755 /usr/local/bin/mihomo; rm /tmp/mihomo.gz
COPY --from=build /qiye-server /usr/local/bin/qiye-server
COPY --from=web /web/dist /app/web/dist
COPY scripts/mihomo-LICENSE.txt /usr/share/doc/mihomo/LICENSE
COPY server/ai_controller/ /app/ai-bundle/server/ai_controller/
COPY server/app/ /app/ai-bundle/server/app/
COPY server/requirements-controller.txt server/requirements-ai*.txt /app/ai-bundle/server/
COPY deploy/compose.ai-node*.yaml deploy/Dockerfile.ai-controller* deploy/ai-node.env.example /app/ai-bundle/deploy/
COPY scripts/ai_node.py scripts/bootstrap_ai_node.py scripts/install_intel_opencl.py /app/ai-bundle/scripts/
COPY docs/AI_NODES.md /app/ai-bundle/docs/
ENV LIBRARY_RUST_BIND=0.0.0.0:8000 LIBRARY_RUST_READ_ONLY=true \
    LIBRARY_FRONTEND_DIST=/app/web/dist LIBRARY_STORAGE_REQUIRE_MARKER=true \
    LIBRARY_MIHOMO_PATH=/usr/local/bin/mihomo LIBRARY_AI_BUNDLE_DIR=/app/ai-bundle
USER library
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s CMD curl --fail --silent http://127.0.0.1:8000/api/health >/dev/null || exit 1
ENTRYPOINT ["qiye-server"]
