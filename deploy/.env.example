# Generate actual credentials with: python scripts/bootstrap_env.py
MYSQL_PASSWORD=replace_with_generated_hex_password
MYSQL_ROOT_PASSWORD=replace_with_generated_hex_password
LIBRARY_ADMIN_PASSWORD=replace_with_a_long_password
LIBRARY_SECRET_KEY=replace_with_generated_secret
LIBRARY_PORT=8800
# Absolute path of a local folder OR an already mounted SMB/NFS share.
# Windows Compose examples: E:/LibraryData, E:/LibraryImports
LIBRARY_DATA_PATH=./data
LIBRARY_IMPORT_PATH=./imports
LIBRARY_MODEL_PATH=./models
# Additional browser origins, comma separated, if using a reverse proxy.
LIBRARY_ALLOWED_ORIGINS=
# Install local inference dependencies when building the image.
INSTALL_AI=false
# cpu (portable default) or intel (amd64 OpenVINO image).
AI_RUNTIME=cpu
# auto, cpu, intel (Intel GPU with CPU fallback), or strict cuda.
LIBRARY_AI_PROVIDER=auto
# Independent queue processes; "thread" is a compatibility/debug mode.
LIBRARY_WORKER_MODE=process
# auto reserves logical CPUs for API and places each queue separately when
# enough CPUs are available. off disables binding; small NAS CPUs may be shared.
LIBRARY_CPU_AFFINITY=auto
# Optional Linux Intel overlay: numeric GID from `stat -c %g /dev/dri/renderD128`.
# LIBRARY_RENDER_GID=109
# LIBRARY_INTEL_DEVICE=/dev/dri/renderD128


# Custom Android builds only: SHA-256 fingerprint of your retained release certificate.
# LIBRARY_ANDROID_CERT_SHA256=your_64_character_lowercase_certificate_digest
