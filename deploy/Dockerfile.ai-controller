FROM python:3.12-slim
ARG AI_RUNTIME=cpu
ARG TARGETARCH
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/qiye/server
COPY server/requirements-controller.txt server/requirements-ai.txt server/requirements-ai-intel.txt /tmp/
COPY scripts/install_intel_opencl.py /tmp/install_intel_opencl.py
RUN pip install --no-cache-dir -r /tmp/requirements-controller.txt && \
    if [ "$AI_RUNTIME" = "intel" ]; then \
      test "$TARGETARCH" = "amd64" && apt-get update && python /tmp/install_intel_opencl.py && \
      pip install --no-cache-dir -r /tmp/requirements-ai-intel.txt && rm -rf /var/lib/apt/lists/*; \
    elif [ "$AI_RUNTIME" = "cpu" ]; then pip install --no-cache-dir -r /tmp/requirements-ai.txt; \
    else echo 'AI_RUNTIME must be cpu or intel' >&2; exit 1; fi
COPY server/ /opt/qiye/server/
CMD ["uvicorn", "ai_controller.main:app", "--host", "0.0.0.0", "--port", "9010", "--no-access-log"]
